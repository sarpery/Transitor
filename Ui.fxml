<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<FlowPane prefHeight="500.0" prefWidth="900.0" style="-fx-background-color: #00A2DB;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Pane id="menuPane" prefHeight="500.0" prefWidth="237.0" style="-fx-background-color: #001C3D;">
            <children>
                <Button id="startButton" layoutX="59.0" layoutY="315.0" mnemonicParsing="false" prefWidth="120.0" style="-fx-background-color: #00A2DB;" text="Find Path" textFill="#FFFFFF">
                    <font>
                        <Font name="Arial Bold" size="20.0" />
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
                <Button id="walkButton" layoutX="56.0" layoutY="222.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="38.0" style="-fx-background-color: #E84E10;" text="Walk" textFill="#FFFFFF">
                    <font>
                        <Font name="Arial Bold" size="20.0" />
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
                <Label id="speedLabel" layoutX="24.0" layoutY="423.0" text="Speed" textFill="#f2f2f2">
                    <font>
                        <Font name="Arial Bold" size="16.0" />
                    </font>
                </Label>
                <Slider id="speedSlider" blockIncrement="1" layoutX="28.0" layoutY="451.0" max="1" min="0" prefHeight="37.0" prefWidth="175.0" showTickLabels="true" showTickMarks="true" value="0" />
                <Label layoutX="25.0" layoutY="470.0" text="1km/h" textFill="#f2f2f2">
                    <font>
                        <Font name="Arial Bold" size="16.0" />
                    </font>
                </Label>
                <Label layoutX="140.0" layoutY="470.0" text="30 km/h" textFill="#f2f2f2">
                    <font>
                        <Font name="Arial Bold" size="16.0" />
                    </font>
                </Label>
            <Label id="titleLabel" layoutX="44.0" layoutY="38.0" prefHeight="37.0" prefWidth="150.0" text="Transitor" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="Arial" size="36.0" />
               </font>
            </Label>
            <Button id="bikeButton" layoutX="138.0" layoutY="222.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="38.0" style="-fx-background-color: #E84E10;" text="Bike" textFill="#FFFFFF">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
               <font>
                  <Font name="Arial Bold" size="20.0" />
               </font>
            </Button>
            <TextField id="targetTextArea" alignment="CENTER" layoutX="45.0" layoutY="149.0" promptText="Target Zip Code">
               <font>
                  <Font name="Arial" size="12.0" />
               </font>
            </TextField>
            <TextField id="startingTextArea" alignment="CENTER" layoutX="45.0" layoutY="111.0" promptText="Starting Zip Code">
               <font>
                  <Font name="Arial" size="12.0" />
               </font>
            </TextField>
            </children>
        </Pane>
        <Pane id="visualizerPane" prefHeight="500.0" prefWidth="663.0">
            <children>
                <Label id="distanceMeasure" layoutX="553.0" layoutY="444.0" text="Distance: 0" textFill="#ffffff">
                    <font>
                        <Font name="Arial Bold" size="16.0" />
                    </font>
                </Label>
            <Label id="timeMeasure" layoutX="553.0" layoutY="466.0" text="Time: 0" textFill="#ffffff">
               <font>
                  <Font name="Arial Bold" size="16.0" />
               </font>
            </Label>
            </children>
        </Pane>
    </children>
</FlowPane>
