<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800" prefWidth="1180" styleClass="app-shell"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.Frontend.UIController">
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="350" minWidth="350" maxWidth="350" styleClass="sidebar-scroll">
            <content>
                <VBox spacing="20" styleClass="sidebar">
                    <padding><Insets top="26" right="24" bottom="24" left="24"/></padding>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane minHeight="42" minWidth="42" prefHeight="42" prefWidth="42" styleClass="brand-mark">
                            <Label text="T" styleClass="brand-letter"/>
                        </StackPane>
                        <VBox spacing="3">
                            <Label text="Transitor" styleClass="brand-title"/>
                            <Label text="MAASTRICHT MOBILITY EXPLORER" styleClass="brand-subtitle"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="10">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="PLAN A JOURNEY" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="swapButton" id="swapButton" text="Swap" onAction="#swapPostcodes" styleClass="text-button" accessibleText="Swap departure and destination postcodes"/>
                        </HBox>
                        <VBox spacing="6">
                            <Label text="From" labelFor="$startZip" styleClass="field-label"/>
                            <TextField id="startingTextArea" fx:id="startZip" promptText="Departure postcode · e.g. 6211 AB" accessibleText="Departure postcode"/>
                            <Label fx:id="startScoreLabel" text="Score: —" styleClass="muted-label"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="To" labelFor="$endZip" styleClass="field-label"/>
                            <TextField id="targetTextArea" fx:id="endZip" promptText="Destination postcode · e.g. 6211 AS" accessibleText="Destination postcode"/>
                            <Label fx:id="endScoreLabel" text="Score: —" styleClass="muted-label"/>
                        </VBox>
                        <Button fx:id="exampleButton" id="exampleButton" text="Try an example walking route →" onAction="#useExample" styleClass="example-button" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="10">
                        <Label text="TRAVEL MODE" styleClass="section-title"/>
                        <HBox spacing="8">
                            <Button fx:id="walkButton" id="walkButton" text="Walk" onAction="#setupWalkButton" styleClass="primary-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="bikeButton" id="bikeButton" text="Bike" onAction="#setupBikeButton" styleClass="secondary-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="transportButton" id="transportButton" text="Transit" onAction="#setupBusButton" styleClass="secondary-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label text="Transit departure" styleClass="field-label"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <ChoiceBox fx:id="hourSelection" id="hourSelection" prefWidth="65" accessibleText="Departure hour"/>
                            <Label text=":" styleClass="time-separator"/>
                            <ChoiceBox fx:id="minuteSelection" id="minuteSelection" prefWidth="65" accessibleText="Departure minute"/>
                            <Button fx:id="currentTime" id="currentTime" text="Current Time" onAction="#onCurrentTimePressed" styleClass="text-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                        <Label fx:id="transitNote" wrapText="true" styleClass="info-note"/>
                    </VBox>

                    <VBox spacing="8" styleClass="summary-card">
                        <Label fx:id="summaryTitle" text="Your route" styleClass="card-title"/>
                        <Label fx:id="distance" id="distanceMeasure" text="Distance: —" styleClass="summary-value"/>
                        <Label fx:id="timeLabel" id="timeMeasure" text="Travel time: —" styleClass="summary-value"/>
                        <Label fx:id="estimateNote" wrapText="true" text="Plan a journey to compare travel estimates and nearby amenities." styleClass="muted-label"/>
                    </VBox>

                    <VBox spacing="10">
                        <Label text="EXPLORE ACCESSIBILITY" styleClass="section-title"/>
                        <Label text="See how nearby shops, services and places of interest vary across the city." wrapText="true" styleClass="body-label"/>
                        <Button fx:id="heatmapButton" id="heatmapButton" text="Show accessibility map" onAction="#setupHeatmapButton" styleClass="secondary-button" maxWidth="Infinity"/>
                        <VBox fx:id="accessibilityPane" spacing="8" visible="false">
                            <Label text="Inspect a postcode" labelFor="$checkZip" styleClass="field-label"/>
                            <TextField fx:id="checkZip" id="checkTextArea" promptText="e.g. 6211 AB" accessibleText="Accessibility postcode"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button fx:id="calculateScoreButton" id="calculateScoreButton" text="Calculate score" onAction="#setupCalculateButton" styleClass="secondary-button"/>
                                <Label fx:id="scoreLabel" id="scoreMeasure" text="Score: —" styleClass="field-label"/>
                            </HBox>
                        </VBox>
                        <Label text="Scores are a student-built amenity heuristic, not an official accessibility rating." wrapText="true" styleClass="fine-print"/>
                    </VBox>
                    <Separator/>
                    <Label text="University group project · 2024 transit dataset" wrapText="true" styleClass="fine-print"/>
                </VBox>
            </content>
        </ScrollPane>
    </left>
    <center>
        <BorderPane styleClass="map-column">
            <top>
                <VBox spacing="14" styleClass="map-header">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="6">
                            <Label text="Maastricht" styleClass="page-title"/>
                            <Label fx:id="routeDescription" text="Find your way through the city" styleClass="page-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Reset view" onAction="#resetMap" styleClass="secondary-button"/>
                        <HBox spacing="1" maxHeight="38" alignment="CENTER" styleClass="zoom-controls">
                            <Button text="−" onAction="#zoomOut" styleClass="zoom-button" accessibleText="Zoom out"/>
                            <Button text="+" onAction="#zoomIn" styleClass="zoom-button" accessibleText="Zoom in"/>
                        </HBox>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-bar">
                        <ProgressIndicator fx:id="progressIndicator" prefHeight="20" prefWidth="20" maxHeight="20" maxWidth="20" visible="false"/>
                        <Label fx:id="statusLabel" id="statusLabel" wrapText="true" styleClass="status-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="cancelButton" text="Cancel" onAction="#cancelCalculation" styleClass="text-button" visible="false"/>
                    </HBox>
                </VBox>
            </top>
            <center>
                <StackPane fx:id="mapPane" id="visualizerPane" styleClass="map-canvas">
                    <VBox fx:id="emptyState" spacing="5" maxWidth="320" maxHeight="105" mouseTransparent="true" styleClass="map-empty-state" StackPane.alignment="BOTTOM_LEFT">
                        <StackPane.margin><Insets top="20" right="20" bottom="20" left="20"/></StackPane.margin>
                        <Label text="Your next journey starts here" styleClass="card-title"/>
                        <Label text="Enter two postcodes or try the example. Drag the map to explore Maastricht." wrapText="true" styleClass="body-label"/>
                    </VBox>
                </StackPane>
            </center>
            <bottom>
                <VBox spacing="10" styleClass="map-footer">
                    <FlowPane fx:id="routeLegend" hgap="14" vgap="6"/>
                    <HBox fx:id="heatmapLegend" spacing="12" visible="false" alignment="CENTER_LEFT">
                        <Label text="Amenity score" styleClass="field-label"/>
                        <Label text="≤150" styleClass="score-low"/>
                        <Label text="151–500" styleClass="score-medium"/>
                        <Label text="501–1000" styleClass="score-high"/>
                        <Label text="&gt;1000" styleClass="score-highest"/>
                    </HBox>
                    <Label text="Map tiles © OpenStreetMap contributors · Internet required for the background map" wrapText="true" styleClass="map-caption"/>
                </VBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
