# Optional: configure a local database to enable public-transport routes.
# Walking, cycling, and accessibility features work without these settings.
# Copy this file to .env and enter your own database account details.
# The application reads exported environment variables, not .env automatically.
# Bash/zsh: set -a; source .env; set +a
# Quote values containing spaces or shell characters when editing this file.
TRANSITOR_DB_URL=jdbc:mysql://localhost:3306/gtfs
TRANSITOR_DB_USER=
TRANSITOR_DB_PASSWORD=
