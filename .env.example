# Default launch manages a local Docker database automatically.
# No .env file or database credentials are needed for that workflow.
# The application reads exported variables, not .env files automatically.

# Optional: skip automatic Docker startup and use only bundled-data features.
# TRANSITOR_DB_AUTO_START=false

# Optional: checkout root for a custom launch location.
# TRANSITOR_PROJECT_DIR=/absolute/path/to/Transitor

# Advanced: use your own database instead of automatic Docker setup.
# Uncomment and fill in ALL three values before exporting them.
# Partial manual settings are an error and do not fall back to Docker.
# TRANSITOR_DB_URL=jdbc:mysql://localhost:3306/gtfs
# TRANSITOR_DB_USER=
# TRANSITOR_DB_PASSWORD=

# To load an edited copy in Bash/zsh: set -a; source .env; set +a
# Quote values containing spaces or shell characters. Keep .env private.
